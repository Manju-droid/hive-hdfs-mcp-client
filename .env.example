# Executable from the existing Hive MCP server installation.
HIVE_MCP_COMMAND=~/Documents/spark-sql-mcp-server/.venv/bin/spark-sql-mcp-server

# HiveServer2 connection passed to the Hive MCP server.
SPARK_HOST=localhost
SPARK_PORT=10000
SPARK_DATABASE=default
SPARK_AUTH=NONE

# Obtain a key from Groq and set it locally; never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Client-side maximum returned rows (1-500).
MAX_RESULT_ROWS=100

# Seconds allowed for MCP operations and an agent response.
MCP_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=120
